//  Theater Utils - MCC theater clip/playback control for three Blam titles:
//  Halo: Reach (haloreach.dll), Halo 3 (halo3.dll) and Halo 3: ODST (halo3odst.dll).
//  Whichever of the three is loaded is detected at startup and its address
//  profile selected; every address below is per-title (see TITLES[]).
//
//    F2  = RELEASE leaked sf_camera.blob / sf_snippet.film handles (fixes F5)
//    F4  = ABORT / unstick   (clear a pending seek + reset the clip state)
//    F5  = START recording   (clip state 0 -> 1, then resumes playback)
//    F6  = STOP / capture    (clip state 1..3 -> 4)
//    F7  = KEYFRAME INDEX    read-only dump of the table skip navigates
//    F8  = PAUSE / PLAY      playback-speed float, 0 <-> previous
//    F9  = SKIP BACK         skip_arm(1)  -> prev keyframe (~10 s)
//    F10 = SKIP FORWARD      skip_arm(2)  -> next keyframe (~10 s)
//    F3  = KEYFRAME CAPTURE  H3/ODST, opt-in via -kf. Live-tested: it does
//                            reach the capture path but the write fails and
//                            theater ejects you, so it is off by default.
//    F12 = SAVE              Reach only (state 4 -> 11, commit)
//    + film-error blocking   (NOP the 13 sites that raise the theater film error;
//                             all three titles have exactly 13 raises + 1 reset)
//    + save-failed blocking  Reach only (NOP the SAVE-FAILED popup + auto-recover
//                             the stuck state-12 commit loop back to a clean state)
//    ESC = restore everything and quit.
//
//  On attach it also provisions the save storage pool, whose Xbox async-storage
//  init is orphaned on PC. Reach's F12 commit needs it.
//
//  Reach F12: the produced .film lands in the game folder as sf_snippet_<hex>.film;
//  drop it into ...\Temporary\UserContent\HaloReach\Movie\ and open the Theater
//  menu and MCC converts + lists it. Full RE notes: theater_playback_controls.md.
//
//  Halo 3 / ODST have no callable save(id,name,desc) entry - their commit runs
//  through the in-game name/description keyboard flow (clip states 4->7->..->11),
//  so F12 and the save-failed handling stay Reach-only. Everything else is ported.
//
//  cl /EHsc /O2 /std:c++17
#include <windows.h>
#include <tlhelp32.h>
#include <cstdio>
#include <cstdint>
#include <cstring>
#include <initializer_list>
#include <vector>
#include <winternl.h>
#pragma comment(lib, "advapi32.lib")
#pragma comment(lib, "user32.lib")

// --- ANSI colors (Windows VT processing; enabled by enableVT() at startup) --
#define C_RST  "\x1b[0m"
#define C_GRN  "\x1b[92m"  // success  [+]
#define C_RED  "\x1b[91m"  // error    [!] fatal
#define C_YEL  "\x1b[93m"  // warning  [!] non-fatal / ignored input
#define C_CYN  "\x1b[96m"  // action   [F5]/[F6]/[F12]
#define C_MAG  "\x1b[95m"  // auto-recover
#define C_GRY  "\x1b[90m"  // state trace
#define C_BLD  "\x1b[1m"   // headers

static void enableVT() {
    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
    DWORD mode = 0;
    if (GetConsoleMode(h, &mode))
        SetConsoleMode(h, mode | ENABLE_VIRTUAL_TERMINAL_PROCESSING);
}

// --- per-title address profiles (all RVAs are VA - 0x180000000) -------------
//  Reach's numbers are the original, live-verified set. The Halo 3 / ODST sets
//  were recovered from halo3.dll.i64 / halo3odst.dll.i64 by following the same
//  anchor chain (sf_snippet.film + sf_camera.blob -> record start -> clip state
//  -> per-frame update -> playback struct) and every byte pattern below was
//  checked against the shipping DLLs.
//
//  The playback-state struct has the same shape in all three: pending skip
//  direction at speed+0x14, error flag at speed+0x4C.

struct Site { uint32_t rva; uint8_t len; uint8_t orig[7]; };

