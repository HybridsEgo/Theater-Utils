struct Title {
    const wchar_t* module;
    const char*    name;
    uint32_t hook;                 // per-frame theater fn we cave into
    uint8_t  hookLen, hookOrig[8]; // its stolen prologue (re-run by the cave)
    uint32_t start, stop, skip;    // clip record start / stop, skip_arm(dir)
    uint32_t poolInit, pool;       // xoverlapped pool creator + its ptr global
    uint32_t state, speed, tick;   // clip state machine, speed float, film tick
    uint32_t saveReal, clipId;     // real save(id,name,desc) + minted id (0 = n/a)
    uint32_t opBase;               // save-op object for auto-recover (0 = n/a)
    // keyframe index: what skip back/forward actually navigates. Entries are
    // {tick at +4, ..., valid flag in the last byte}; the payload each entry
    // points at is a multi-MB state snapshot in a scratch file, not in here.
    uint32_t kfTable; uint8_t kfSlots, kfStride, kfTickOff, kfValidOff;
    uint32_t clipReset;            // engine's own clip-state reset, no args (0 = n/a)
    // Clip length budget. STOP only succeeds while
    //   clipStart + clipMaxLen - tick >= 0
    // and in Halo 3 / ODST this global has exactly ONE xref in the whole binary -
    // that read - so nothing ever initialises it and it stays 0. That collapses
    // the stop window to the single tick the clip started on, i.e. recording can
    // never be stopped. Seeding it makes STOP reachable again.
    uint32_t clipMaxLen, clipStart, clipEnd;
    // Record-start does three things in order and any one can silently abort it:
    //   sub_1800B4E78(camblob, "sf_camera.blob", 2)     -> handle at blob+144
    //   sub_180107590(writer, "sf_snippet.film", ...)   -> writer state at +0
    //   sub_1800F2300(tick, 0)                          -> the seek
    // These let the tool say WHICH step failed instead of guessing. 0 = unmapped.
    uint32_t camBlobHandle, camBlobMode, filmWriterState;
    // Record-start opens sf_camera.blob and sf_snippet.film and NOTHING closes
    // them - the clip reset doesn't, so the handles leak for the life of the
    // process. Since the engine opens with ShareMode: None, every later attempt
    // dies with a SHARING VIOLATION and record-start silently fails. These are
    // the engine's own close routines (as used by the theater teardown
    // sub_1800F16FC), each taking one pointer, so F4 can call them.
    uint32_t closeBlobFn, camBlobObj, closeWriterFn, filmWriterObj;
    uint32_t filmWriterErr;        // writer object + 65524, must be 0 to finalise
    // The stop's length-budget load:
    //     mov ecx, cs:<budget>      8B 0D rel32   (6 bytes)
    //     sub ecx, eax / add ecx, edx / js -> fail
    // The budget global lives INSIDE the film-writer object and the engine holds
    // it at 0 for the whole recording (writing it back is undone within a frame),
    // so the window collapses to tick == clipStart and stop can never succeed.
    // Replacing the load with `mov ecx, imm32; nop` supplies the budget at the
    // point of use where nothing can zero it. 0 = don't patch (Reach's clip
    // recorder works as shipped - leave it alone).
    uint32_t clipLenPatch;
    // Keyframe capture-mode gates. The keyframe writer runs every tick but bails
    // unless the film block's mode byte is 2; during theater playback it is 1,
    // so no keyframe is ever captured and skip/rewind has nothing to jump to.
    // These are the two `cmp byte ptr [rax+10h], 2` sites in the writer - drop
    // the immediate to 1 and it captures during playback instead. Experimental,
    // off by default (F11).
    // THREE gates, not two. Two live in the writer sub_1801CDF40 and let the
    // 9.9 MB snapshot get written; the third is in the per-tick caller
    // sub_1800361A8 and guards the block that PUBLISHES the index entry - it
    // stamps entry +0/+4(tick)/+12 and `mov word [..+1Eh], 100h` = valid.
    // Patch only the first two and the data lands but no slot ever validates,
    // so skip still has nothing to navigate. Encodings differ: the writer's are
    // `cmp byte [rax+10h],2` (80 78 10 02), the finaliser's is [rcx+10h]
    // (80 79 10 02), so each carries its expected modrm.
    uint32_t kfGate[3];
    uint8_t  kfGateModrm[3];
    const ErrCode*  codes; int nCodes;
    const Site*     err;  int nErr;
    const uint32_t* popup; int nPopup;
};

